# ==============================================================================
# FLODSS v1.0.0-rc.1 — Production Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL.
# Copy this file to .env.production on the private research host and chmod 600.

# 1. Project Identity & Version
PROJECT_NAME="Facility Layout Optimization & Decision Support System (FLODSS)"
VERSION="1.0.0-rc.1"
API_V1_PREFIX="/api"
FASTAPI_DEBUG=false

# 2. Host Binding & Security Secrets
# Generate high-entropy secret using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY_MIN_48_CHARS"
AI_CONSENT_SECRET="REPLACE_WITH_UNIQUE_AI_CONSENT_SECRET_MIN_32_CHARS"

# 3. Database Persistence
DATABASE_PATH="data/flodss_research.db"

# 4. Session & Invitation Lifecycles
SESSION_EXPIRE_HOURS=24
INVITATION_EXPIRE_HOURS=48

# 5. Resource & Execution Governance
MAX_CONCURRENT_JOBS_PER_USER=1
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
AUTH_ENFORCED=true

# 6. Initial Administrator Bootstrap (Mandatory to change on first login)
DEFAULT_ADMIN_EMAIL="admin@flodss.local"
DEFAULT_ADMIN_PASSWORD="REPLACE_WITH_INITIAL_STRONG_ADMIN_PASSPHRASE_MIN_16_CHARS"
DEFAULT_ADMIN_NAME="Lead Research Administrator"

# 7. Reverse Proxy & CORS Allowed Origins
# List the exact hostnames or internal IP addresses that access FLODSS
CORS_ORIGINS='["http://127.0.0.1:5173", "http://localhost:5173", "https://flodss-lab.internal.university.edu"]'

# 8. External AI Reasoning (Disabled by default to protect proprietary IP)
AI_ENABLED=false
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=15.0
